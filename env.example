# ── Database (MongoDB Atlas for development) ──
# Atlas: Database → Connect → copy the connection string, replace USER/PASSWORD.
# Network Access: add your current IP (or 0.0.0.0/0 for dev only).
# If you see SSL/TLS errors, the cluster may be paused/deleted or the hostname is wrong.
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/proteq?retryWrites=true&w=majority&appName=your-cluster

# Local MongoDB alternative (no Atlas):
# DATABASE_URI=mongodb://127.0.0.1:27017/proteq

# ── Payload ──
PAYLOAD_SECRET=change-me-to-a-long-random-string
PREVIEW_SECRET=change-me-to-another-long-random-string
CRON_SECRET=change-me-cron-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Storage (cloudinary for dev, s3 for production) ──
STORAGE_ADAPTER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ── S3 (production only) ──
# STORAGE_ADAPTER=s3
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Brevo (Phase 1 — forms) ──
# BREVO_API_KEY=
# BREVO_LIST_ID=

# ── Aurum (AI Investments) ──
# NEXT_PUBLIC_AURUM_REFERRAL_URL=https://aurum-foundation.com/register?ref=your-code

# ── Analytics ──
# NEXT_PUBLIC_GA_ID=
